# ── Sentinel AI — Global Environment Variables Example ────────────────────────

# Environment Mode: development | staging | production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Database Connection (Neon PostgreSQL URL in Production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/sentinel_ai

# Redis Connection (Upstash Redis URL in Production)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens (Must be minimum 32 characters in production)
SECRET_KEY=sentinel-ai-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=sentinel-ai-jwt-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS & Trusted Domains (Comma-separated)
CORS_ORIGINS=https://sentinel-ai.vercel.app,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,*.vercel.app

# OpenAI API Key (Optional — fallback heuristics used if omitted)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
